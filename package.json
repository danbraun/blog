{
  "name": "blog",
  "version": "1.0.0",
  "description": "my personal blog",
  "main": "index.js",
  "scripts": {
    "watch:sass": "sass  --no-source-map --watch src/scss:public/css",
    "watch:eleventy": "eleventy --serve",
    "start": "npm-run-all build:sass --parallel watch:*",
    "build": "npm-run-all build:sass build:eleventy",
    "build:sass": "sass  --no-source-map src/scss:public/css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danbraun/blog.git"
  },
  "author": "Daniel Braun",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/danbraun/blog/issues"
  },
  "homepage": "https://github.com/danbraun/blog#readme",
  "devDependencies": {
    "@11ty/eleventy": "^1.0.2",
    "lightningcss-cli": "^1.18.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.57.1"
  }
}
