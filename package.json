{
  "name": "blog",
  "version": "1.0.0",
  "description": "my personal blog",
  "main": "index.html",
  "browserslist": [
    "> 0.25%",
    "not IE 11"
  ],
  "scripts": {
    "watch:sass": "sass --watch src/scss:public/css",
    "watch:eleventy": "eleventy --serve",
    "start": "run-p watch:*",
    "build": "run-p build:sass build:eleventy",
    "build:sass": "sass --no-source-map src/scss:public/css",
    "build:eleventy": "eleventy",
    "postbuild": "lightningcss --minify --browserslist public/css/style.css -o public/css/style.css",
    "clean": "rm -rf public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danbraun/blog.git"
  },
  "author": "Daniel Braun",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/danbraun/blog/issues"
  },
  "homepage": "https://github.com/danbraun/blog#readme",
  "devDependencies": {
    "@11ty/eleventy": "^1.0.2",
    "@11ty/eleventy-fetch": "^3.0.0",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.2.0",
    "eleventy-plugin-metagen": "^1.7.11",
    "esbuild": "^0.16.17",
    "lightningcss-cli": "^1.18.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.57.1"
  }
}
