---
layout: base.njk
---
<h2>Posts:</h2>

<ul>
{%- for post in collections.orderedPosts -%}
  {%- if post.data.publish %}
    <li class="post-listing"><span class="post-date">{{ post.date | postDate }}</span>
    <br><a href="{{ post.url }}">{{ post.data.title }}</a><br> 
    <span class="excerpt">{{ post.data.excerpt }}</span></li>
  {%- endif %}
{%- endfor -%}
</ul>