<ul>
    {%- for post in postlist | reverse -%}
        {%- if post.data.publish %}
            <li class="post-listing">
                <div class="post-date">{{ post.date | postDate }}</div>
                {%- set tags = post.data.tags -%}
                {%- include 'taglist.njk' -%}
                <div>
                    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                    <div class="post-excerpt">{{ post.data.excerpt }}</div>
                </div>
            </li>
        {%- endif %}
    {%- endfor -%}
</ul>