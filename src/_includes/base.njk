<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="{{ '/css/style.css' | url}}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <script src="https://kit.fontawesome.com/6f2a8c42bd.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <header>
      <a href="/">
        <img width="200" height="200" id="headerImg" class="header-circle-image" src="" alt="Photo of blog author">
      </a>
      <h1>{{ title }}</h1>

      <nav>
        <a href="/">Blog</a> | <a href="/about">About</a>
      </nav>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,700;1,400&display=swap">
    </header>
    <main>

      {{ content | safe}}
    </main>
    <footer>
      <div class="footer-content">
        &copy;{% year %} Daniel Braun |  <a href="http://localhost:8080/feed.xml">RSS Feed&nbsp;
        <i class="fa-solid fa-square-rss fa-lg"></i></a> | Built with Eleventy {{ eleventy.version }}
      </div>
    </footer>
    <script src="{{ '/js/bundle.js' | url }}"></script>
  </body>
</html>